{
  "name": "@local/dsh-pomodoro-box",
  "version": "1.1.0",
  "private": true,
  "description": "A pomodoro timer for the DeepSeek Harness composer dock that opens a collectible blind box after every focus session.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "pomodoro",
    "blind-box",
    "productivity"
  ],
  "author": "WU55UY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WU55UY/dsh-pomodoro-box.git"
  },
  "homepage": "https://github.com/WU55UY/dsh-pomodoro-box#readme",
  "bugs": {
    "url": "https://github.com/WU55UY/dsh-pomodoro-box/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
